DATABASE_URL=mysql://root:password@127.0.0.1:3306/toigibando
# TiDB production: mysql://user:password@host:4000/toigibando and DATABASE_SSL=true
DATABASE_SSL=false
SITE_URL=http://127.0.0.1:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
# Google OAuth: Web application client; callback = SITE_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email verification over SMTP. 587 uses STARTTLS; 465 uses SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tôi gì, bạn đó! <noreply@toigibando.app>"
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:3001
WS_PORT=3001
WS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
GOONG_API_KEY=
NEXT_PUBLIC_GOONG_MAP_KEY=
BLOB_PUBLIC_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=
CRON_SECRET=replace-with-a-random-secret
# Web Push: npm run push:keys, then copy values from ignored .local/push-keys/*.txt.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://toigibanthe.vercel.app
# Required only for explicitly seeding development accounts. No production defaults.
SEED_PASSWORD=
