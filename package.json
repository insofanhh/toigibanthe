{
  "name": "toi-gi-ban-do",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "dev:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/reset-local-web.ps1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:seed:export": "tsx scripts/export-demo-seed.ts",
    "db:seed:export:admin-chef": "tsx scripts/export-admin-chef-db.ts",
    "db:seed:repair:credentials": "node scripts/repair-demo-credentials.mjs",
    "realtime": "tsx --env-file=.env.local services/realtime/server.ts",
    "test": "tsx --test tests/domain.test.ts tests/client-load-cache.test.ts tests/analytics-domain.test.ts tests/animated-number.test.ts tests/google-auth.test.ts tests/home-popups.test.ts tests/realtime-config.test.ts tests/api-response.test.ts tests/avatar-upload.test.ts",
    "test:analytics": "tsx --env-file=.env.local tests/analytics.integration.ts",
    "test:users": "tsx --env-file=.env.local tests/admin-users.integration.ts",
    "test:access": "tsx --env-file=.env.local tests/admin-user-access.integration.ts",
    "test:account": "tsx --env-file=.env.local tests/user-account.integration.ts",
    "test:account:http": "tsx --env-file=.env.local tests/user-account-http.integration.ts",
    "test:avatar:browser": "node tests/avatar-upload.browser.cjs",
    "test:account:browser": "tsx --env-file=.env.local tests/admin-user-deletion.browser.ts",
    "test:email-verification": "tsx --env-file=.env.local tests/email-verification.integration.ts",
    "test:email-verification:http": "tsx --env-file=.env.local tests/email-verification-http.integration.ts",
    "mail:check": "tsx --env-file=.env.local scripts/check-smtp.ts",
    "test:registrations": "tsx --env-file=.env.local tests/admin-registration-alerts.integration.ts",
    "test:chef-applications": "tsx --env-file=.env.local tests/admin-chef-application-alerts.integration.ts",
    "test:chef-access": "tsx --env-file=.env.local tests/admin-chef-access.integration.ts",
    "test:chefs": "tsx --env-file=.env.local tests/admin-chefs.integration.ts",
    "test:products": "tsx --env-file=.env.local tests/admin-products.integration.ts",
    "test:orders": "tsx --env-file=.env.local tests/admin-orders.integration.ts",
    "test:delivery-reminders": "tsx --env-file=.env.local tests/delivery-reminders.integration.ts",
    "test:integration": "tsx --env-file=.env.local tests/integration.ts",
    "test:location": "tsx --env-file=.env.local tests/kitchen-location.integration.ts",
    "test:chef-map": "tsx --env-file=.env.local tests/chef-map.integration.ts",
    "test:home-popups": "tsx --env-file=.env.local tests/home-popups.integration.ts",
    "test:sepay": "tsx --env-file=.env.local tests/sepay.integration.ts",
    "push:keys": "tsx scripts/push-keys.ts",
    "test:push": "tsx --env-file=.env.local tests/push.integration.ts",
    "test:push:worker": "node --test tests/push-worker.test.cjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.577.0",
    "mysql2": "^3.14.5",
    "next": "16.3.8",
    "nodemailer": "^10.0.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
